
@article{jana_spectral_2026,
	title = {Spectral reciprocity for {GL}(n) and simultaneous non-vanishing of central L-values},
	volume = {148},
	issn = {1080-6377},
	url = {https://muse.jhu.edu/pub/1/article/980773},
	abstract = {Let \$F\$ be a totally real number field and \$n{\textbackslash}ge 3\$. Let \${\textbackslash}Pi\$ and \${\textbackslash}pi\$ be cuspidal automorphic representations for \${\textbackslash}mathrm\{{PGL}\}\_\{n+1\}(F)\$ and \${\textbackslash}mathrm\{{PGL}\}\_\{n-1\}(F)\$, respectively, that are unramified and tempered at all finite places. We prove simultaneous non-vanishing of the Rankin--Selberg \$L\$-values \$L(1/2,{\textbackslash}Pi{\textbackslash}otimes{\textbackslash}widetilde\{{\textbackslash}sigma\})\$ and \$L(1/2,{\textbackslash}sigma{\textbackslash}otimes{\textbackslash}widetilde\{{\textbackslash}pi\})\$ for certain sequences of \${\textbackslash}sigma\$ varying over cuspidal automorphic representations for \${\textbackslash}mathrm\{{PGL}\}\_n(F)\$ with conductor tending to infinity in the level aspect and bearing certain local conditions. Along the way, we also prove a reciprocity formula for the average of the product of Rankin--Selberg \$L\$-functions \$L(1/2,{\textbackslash}Pi{\textbackslash}otimes{\textbackslash}widetilde\{{\textbackslash}sigma\})L(1/2,{\textbackslash}sigma{\textbackslash}otimes{\textbackslash}widetilde\{{\textbackslash}pi\})\$ over a conductor aspect family of \${\textbackslash}sigma\$.},
	pages = {247--311},
	number = {1},
	journaltitle = {American Journal of Mathematics},
	publisher = {Johns Hopkins University Press},
	author = {Jana, Subhajit and Nunes, Ramon},
	urldate = {2026-02-12},
	date = {2026},
	file = {arXiv Fulltext PDF:/Users/ramonmoreiranunes/Zotero/storage/MBN2BUIZ/Jana and Nunes - 2021 - Spectral reciprocity for \$mathrm GL (n)\$ and simu.pdf:application/pdf},
}
